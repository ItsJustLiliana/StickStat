DATABASE_URL="postgresql://stickstat:CHANGE_ME@127.0.0.1:5432/stickstat"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
PORT=4000
HOSTNAME=0.0.0.0
APP_URL="http://localhost:4000"
STICKSTAT_RELEASE_FEED_URL="https://liliananuzohra.com/api/stickstat-release.php"
NEXT_PUBLIC_STICKSTAT_RELEASE_MANAGER_URL="https://liliananuzohra.com/edit-website"
SYNC_INTERVAL_MINUTES=60
ALLOW_REGISTRATION=true
# Gebruik false voor de huidige HTTP/Tailscale-installatie en true zodra StickStat via HTTPS draait.
SESSION_COOKIE_SECURE=false
STICKSTAT_BACKUP_DIR=/projects/StickStat-backups
STICKSTAT_BACKUP_RETENTION_DAYS=14
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="change-this-before-seeding"
