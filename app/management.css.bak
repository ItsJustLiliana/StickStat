.avatar{color:white;text-decoration:none}
.form-stack{display:grid;gap:12px}
.form-stack .input{width:100%}
.player-detail-fields{display:grid;grid-template-columns:minmax(0,.55fr) minmax(0,1fr);gap:10px}.player-detail-fields .input{min-width:0}
.role-options{display:flex;flex-wrap:wrap;gap:8px}
.role-options label{display:flex;align-items:center;gap:6px;background:#eef4f0;border:1px solid var(--line);border-radius:999px;padding:7px 10px;font-size:12px;font-weight:750}
.role-options label:has(input:checked){background:var(--green);border-color:var(--green);color:white}.role-options input{accent-color:var(--lime)}
.admin-protection-note{margin:14px 0 0;font-size:13px}.form-message{margin:14px 0 0;padding:11px 13px;border-radius:12px;background:#eef4f0;color:var(--green);font-size:13px;font-weight:750}
.member-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.danger-button{color:#a63415!important;background:#ffebe5!important}.danger-button:hover{background:#ffddd2!important}
.logout-card{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:18px}.logout-card h2{margin-bottom:5px}.logout-card p{margin:0}
.logout-card-action{justify-content:flex-end}
.management-filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}.list-detail{font-size:12px;margin-top:4px}.club-logo-preview{width:72px;height:72px;border-radius:16px;object-fit:contain;background:white;border:1px solid var(--line)}.club-logo-preview.placeholder{display:grid;place-items:center;color:var(--green);font-weight:900}.upload-button{display:inline-block}
.member-roles{display:flex;gap:5px;flex-wrap:wrap;margin-top:6px}
.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.avatar img{width:100%;height:100%;object-fit:cover;border-radius:50%}
.profile-photo-card{max-width:920px}.profile-photo{width:92px;height:92px;border-radius:50%;object-fit:cover;background:#e7efe9}.profile-photo.placeholder{display:grid;place-items:center;color:var(--green);font-size:26px;font-weight:900}.crop-editor{display:grid;gap:12px;margin-top:18px;max-width:520px}.crop-help{margin:0}.crop-frame{width:min(100%,420px);aspect-ratio:1;position:relative;overflow:hidden;border-radius:22px;background:#dfe9e3;cursor:grab;touch-action:none;user-select:none}.crop-frame:active{cursor:grabbing}.crop-frame canvas{width:100%;height:100%;display:block}.crop-frame span{position:absolute;inset:6%;border:3px solid white;border-radius:50%;box-shadow:0 0 0 999px #092f2566;pointer-events:none}.crop-editor label{display:grid;grid-template-columns:90px 1fr;align-items:center;gap:12px;font-size:13px;font-weight:800}
.player-photo.image{object-fit:cover;padding:0;overflow:hidden}
.role-sections{display:grid;gap:38px}
.role-section-head{display:flex;align-items:end;justify-content:space-between;margin-bottom:14px}
.role-section-head h2{margin:5px 0 0}
.role-sections .player-grid{grid-template-columns:repeat(auto-fit,minmax(280px,360px));justify-content:start}
.roster-list{display:grid;max-width:720px;border:1px solid var(--line);border-radius:18px;background:white;overflow:hidden}.roster-list-item{display:flex;align-items:center;gap:14px;min-height:72px;padding:10px 16px;color:inherit;text-decoration:none;border-top:1px solid var(--line);transition:.15s}.roster-list-item:first-child{border-top:0}.roster-list-item:hover{background:#f2f7f4}.roster-list-item .player-photo{width:48px;height:48px;border-radius:14px;flex:0 0 auto}.roster-list-item strong{font-size:15px}
.roster-membership-hint{margin-left:auto;color:var(--muted);font-size:11px;font-weight:750;letter-spacing:.03em}
.binding-form{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:start}.binding-form>label{display:grid;gap:7px;font-size:13px;font-weight:850}.binding-form>label .input{width:100%}.binding-form fieldset{grid-column:1/-1;border:1px solid var(--line);border-radius:14px;padding:14px}.binding-form legend{padding:0 7px;font-size:13px;font-weight:850}.binding-form>.button{grid-column:1/-1}
.match-entry{margin-top:18px}.match-entry-list{display:grid;gap:8px}.match-entry-list article{display:grid;grid-template-columns:minmax(220px,1.4fr) repeat(4,auto) auto minmax(180px,1fr);align-items:center;gap:12px;padding:12px;border:1px solid var(--line);border-radius:14px}.match-entry-list article.inactive{opacity:.55}.match-entry-list article>div>span{display:block;font-size:10px;text-transform:uppercase;color:var(--muted);font-weight:850;text-align:center;margin-bottom:5px}.match-entry-player{display:flex;align-items:center;justify-content:space-between;gap:10px}.match-entry-player .input{min-width:145px}.stepper{display:grid;grid-template-columns:28px 28px 28px;align-items:center;text-align:center}.stepper button{width:28px;height:28px;border:1px solid var(--line);background:white;color:var(--green);font-size:18px;font-weight:900;cursor:pointer}.stepper button:first-child{border-radius:9px 0 0 9px}.stepper button:last-child{border-radius:0 9px 9px 0}.stepper strong{height:28px;line-height:28px;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.mvp-check{display:flex;align-items:center;gap:5px;font-size:12px;font-weight:850}.card-dots{display:flex;gap:5px}.card-dots i{width:11px;height:16px;border-radius:2px}.card-dots .green{background:#29a36a}.card-dots .yellow{background:#f2ca32}.card-dots .red{background:#dc3f32}
.member-metrics .text-metric{font-size:18px;letter-spacing:-.02em;overflow-wrap:anywhere}
.ranking-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:18px}.ranking-list{display:grid}.ranking-row{display:grid;grid-template-columns:30px 1fr auto;align-items:center;gap:10px;color:inherit;text-decoration:none;padding:12px 0;border-top:1px solid var(--line)}.ranking-row:first-child{border-top:0}.ranking-row:hover strong{color:var(--green)}.ranking-position{font-weight:950;color:var(--muted)}.ranking-row small{display:block;color:var(--muted);margin-top:3px}.ranking-value{font-size:20px}.card-summary{display:flex;align-items:center;gap:5px}.card-summary i{width:10px;height:15px;border-radius:2px}.card-summary .green{background:#29a36a}.card-summary .yellow{background:#f2ca32}.card-summary .red{background:#dc3f32}
.statistics-metrics .metric{position:relative;overflow:hidden}.statistics-metrics .metric:after{content:"";position:absolute;width:58px;height:58px;border:14px solid #c9f45b18;border-radius:50%;right:-22px;bottom:-25px}.statistics-metrics .metric small{display:block;margin-top:6px;color:var(--muted);font-size:11px;font-weight:700}.performance-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:18px;margin-bottom:18px}.performance-card,.split-card{min-height:220px}.performance-points{font-size:34px;color:var(--green);letter-spacing:-.05em}.performance-points small{display:block;color:var(--muted);font-size:10px;text-align:right;text-transform:uppercase;letter-spacing:.08em}.result-bar{height:18px;display:flex;overflow:hidden;border-radius:999px;background:#e9efeb}.result-bar i{display:block;height:100%;min-width:0}.result-bar .won,.result-legend .won{background:#0c5c42}.result-bar .drawn,.result-legend .drawn{background:#c9f45b}.result-bar .lost,.result-legend .lost{background:#ff7043}.result-legend{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:24px}.result-legend span{display:grid;grid-template-columns:10px 1fr auto;align-items:center;gap:7px;color:var(--muted);font-size:12px}.result-legend i{width:10px;height:10px;border-radius:3px}.result-legend strong{color:var(--ink);font-size:18px}.table-scroll{max-width:100%;overflow-x:auto}.statistics-table{width:100%;font-variant-numeric:tabular-nums}.statistics-table th{white-space:nowrap}.statistics-table tbody tr{transition:background .15s ease}.statistics-table tbody tr:hover{background:#f2f7f4}.statistics-table td{white-space:nowrap}.split-table td:not(:first-child),.split-table th:not(:first-child){text-align:center}.split-table td:first-child small{display:block;margin-top:3px;color:var(--muted);font-size:10px}.record-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:18px}.record-card{min-width:0;padding:17px 18px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(135deg,var(--card),#f2f8f4);box-shadow:0 8px 22px #13382a08}.record-card span{display:block;margin-bottom:8px;color:var(--muted);font-size:10px;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.record-card strong{display:block;overflow-wrap:anywhere;font-size:16px}.record-card>small{display:block;margin-top:5px;color:var(--muted)}.statistics-charts{margin-bottom:18px}.statistics-charts .player-chart-card{grid-column:1/-1}.chart-card .card-head{margin-bottom:8px}.player-statistics-card{margin-top:18px}.player-statistics-table{min-width:880px}.player-statistics-table th:not(:nth-child(2)),.player-statistics-table td:not(:nth-child(2)){text-align:center}.table-rank{color:var(--muted);font-weight:900}.player-stat-link{color:var(--ink);font-weight:850;text-decoration:none}.player-stat-link:hover{color:var(--green)}.contribution-total{display:inline-grid;min-width:32px;height:32px;place-items:center;border-radius:9px;background:#eaf2ed;color:var(--green)}.section-head{margin-top:34px}.section-head h2{margin:5px 0 0;font-size:28px}
.invite-link{display:flex;gap:8px;margin-top:14px}.invite-link .input{flex:1}.invite-link-button{display:inline-block;text-decoration:none;margin-top:10px}
.icon-button{width:38px;height:38px;border:1px solid var(--line);border-radius:11px;background:white;color:var(--green);display:grid;place-items:center;cursor:pointer}.icon-button:hover{background:#eef4f0}
.compact-button{display:inline-flex;align-items:center;gap:6px;padding:9px 12px;border-radius:10px;font-size:13px;white-space:nowrap}.player-detail-actions{display:flex;flex-direction:row-reverse;align-items:center;gap:10px}.player-action-stack{display:grid;gap:6px}.player-action-stack .icon-button{width:34px;height:34px;border-radius:10px}.management-dialog-backdrop{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:20px;background:#092f2580;backdrop-filter:blur(4px)}.management-dialog{width:min(100%,620px);max-height:calc(100vh - 40px);overflow:auto;box-shadow:0 24px 80px #092f2540}.management-dialog .card-head{margin-bottom:18px}.management-dialog p:first-of-type{margin-top:0}
.management-dialog fieldset{border:1px solid var(--line);border-radius:14px;padding:12px}.management-dialog fieldset legend{padding:0 6px;font-size:13px;font-weight:850}.management-dialog fieldset small{display:block;margin-top:8px}
.team-settings-grid{display:grid;gap:14px}.team-settings-grid>.card{box-shadow:none;background:#f8fbf9}
@media(max-width:900px){.profile-grid,.binding-form{grid-template-columns:1fr}.match-entry{overflow:visible}.match-entry-list{min-width:0}.match-entry-list article{grid-template-columns:repeat(4,minmax(0,1fr));align-items:end}.match-entry-player{grid-column:1/-1}.match-entry-list .notes{grid-column:1/-1;width:100%}.mvp-check{min-height:38px}.roster-list-item>strong{min-width:0;overflow-wrap:anywhere}}
@media(max-width:900px){.ranking-grid,.performance-grid{grid-template-columns:1fr}.record-grid{grid-template-columns:1fr}.statistics-charts .player-chart-card{grid-column:auto}}
@media(max-width:420px){.role-sections .player-grid{grid-template-columns:1fr}}
@media(max-width:560px){.player-detail-fields{grid-template-columns:1fr 1fr}.player-detail-fields .input{width:100%;min-width:0}.player-detail-actions{width:100%;align-items:center;justify-content:space-between}.management-dialog-backdrop{place-items:end center;padding:10px 10px max(10px,env(safe-area-inset-bottom))}.management-dialog{max-height:calc(100svh - 20px);border-radius:20px}.match-entry-list article{grid-template-columns:repeat(2,minmax(0,1fr));gap:14px 10px;padding:14px}.match-entry-list article>div>span{text-align:left}.match-entry-player{align-items:flex-start;flex-direction:column}.match-entry-player .input{width:100%;min-width:0}.match-entry-list .notes{grid-column:1/-1}.stepper{grid-template-columns:36px minmax(32px,1fr) 36px}.stepper button{width:36px;height:36px}.stepper strong{height:36px;line-height:36px}.invite-link{flex-direction:column}.invite-link .input{width:100%;min-width:0}.logout-card{align-items:stretch;flex-direction:column}.logout-card .button{width:100%}.crop-editor label{grid-template-columns:1fr;gap:6px}.role-section-head{align-items:flex-start;gap:10px}.roster-list-item{padding:10px 12px}.roster-membership-hint{max-width:82px;text-align:right}.profile-photo-card .member-actions .button{flex:1 1 140px;text-align:center}.binding-form fieldset{min-width:0}.team-settings-grid>.card{padding:14px}}
@media(max-width:560px){.result-legend{gap:6px}.result-legend span{grid-template-columns:9px 1fr;gap:5px}.result-legend strong{grid-column:2;font-size:16px}.record-card{padding:15px}.player-statistics-card{padding:14px 0}.player-statistics-card>.card-head,.player-statistics-card>.empty{padding-left:14px;padding-right:14px}.statistics-table th,.statistics-table td{padding-left:9px;padding-right:9px}.section-head h2{font-size:24px}}
html[data-theme="dark"] .team-switch,html[data-theme="dark"] .input,html[data-theme="dark"] .player-card,html[data-theme="dark"] .roster-list,html[data-theme="dark"] .icon-button,html[data-theme="dark"] .stepper button,html[data-theme="dark"] .logo,html[data-theme="dark"] .club-logo-preview{background:var(--card);color:var(--ink)}
html[data-theme="dark"] .roster-list-item:hover,html[data-theme="dark"] .icon-button:hover{background:#1d332a}
html[data-theme="dark"] .player-photo,html[data-theme="dark"] .profile-photo.placeholder{background:#20372d;color:var(--green)}
html[data-theme="dark"] .badge,html[data-theme="dark"] .role-options label,html[data-theme="dark"] .form-message{background:#20372d;color:var(--green)}
html[data-theme="dark"] .badge.accent{background:var(--lime);color:#17300e}
html[data-theme="dark"] .active-row{background:#20372d}
html[data-theme="dark"] .button{background:#126a4d}
html[data-theme="dark"] .button:hover{background:#16805d}
html[data-theme="dark"] .button.secondary{background:#243b31;color:var(--green)}
html[data-theme="dark"] .role-options label:has(input:checked){background:#126a4d;color:white}
html[data-theme="dark"] .danger-button{background:#48251f!important;color:#ff9c83!important}
html[data-theme="dark"] .danger-button:hover{background:#5b2d25!important}
html[data-theme="dark"] .team-settings-grid>.card{background:#192a23}
html[data-theme="dark"] .recharts-cartesian-axis-tick-value{fill:var(--muted)}
html[data-theme="dark"] .recharts-cartesian-grid line{stroke:var(--line)}
html[data-theme="dark"] .recharts-default-tooltip{background-color:var(--card)!important;border-color:var(--line)!important;color:var(--ink)!important}
html[data-theme="dark"] .statistics-table tbody tr:hover{background:#1d332a}
html[data-theme="dark"] .record-card{background:linear-gradient(135deg,var(--card),#192d24)}
html[data-theme="dark"] .contribution-total{background:#20372d}

