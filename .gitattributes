# Auto normalize line endings for all files
* text=auto

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf
deploy/*.sh text eol=lf
scripts/*.sh text eol=lf

# Windows batch files
*.cmd text eol=crlf
*.bat text eol=crlf

# Source code
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf

# Configuration
*.yml text eol=lf
*.yaml text eol=lf
tsconfig.json text eol=lf
package.json text eol=lf
prisma.config.ts text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
